FROM python:3.11-slim

# A conservative sandbox image that can run ts-agents tools.
#
# Build:
#   docker build -f Dockerfile.sandbox -t ts-agents-sandbox:latest .
#
# Optional extras (comma-separated, e.g. forecasting,ml or foundation):
#   docker build -f Dockerfile.sandbox --build-arg TS_AGENTS_EXTRAS=foundation \
#     -t ts-agents-sandbox:foundation .
# Foundation-model weights are not baked in; containers run with no network by
# default, so mount a pre-populated HF_HOME (with HF_HUB_OFFLINE=1) or allow
# network access.

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# System dependencies for common scientific Python wheels.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      git \
    && rm -rf /var/lib/apt/lists/*

# Copy just the minimal project files for editable install.
COPY pyproject.toml uv.lock README.md ./
COPY ts_agents ./ts_agents

ARG TS_AGENTS_EXTRAS=""

RUN python -m pip install --upgrade pip && \
    python -m pip install -e ".${TS_AGENTS_EXTRAS:+[$TS_AGENTS_EXTRAS]}"

# Default command is the sandbox runner help.
CMD ["python", "-m", "ts_agents.sandbox.runner", "--help"]
